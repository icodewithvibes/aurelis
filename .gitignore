# ─────────────────────────────────────────────────────────────
# AURELIS .gitignore
# V1 is local-first with NO secrets in the client. Keep it that way.
# ─────────────────────────────────────────────────────────────

# ── Privacy / copyright: never upload reference material ──
# Pinterest mood images + copied MotionSites prompts (style refs only).
/01_references/

# Raw generation candidates: reviewed locally, never committed.
# Only compressed, approved exports under /03_assets/approved/ ship.
/03_assets/candidates/

# ── Secrets / environment (there should be NONE in V1) ──
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.*
**/secrets/

# ── Node / package managers ──
node_modules/
.pnp/
.pnp.js
.yarn/
.npm/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Vite / build output ──
dist/
dist-ssr/
build/
.vite/
*.local

# ── Test / coverage / caches ──
coverage/
.nyc_output/
.eslintcache
.cache/
*.tsbuildinfo

# ── Generated app data, exports & user content (NEVER commit) ──
# Local training logs, private notes, Forge entries, JSON backups, etc.
/data/
.aurelis/
*.aurelis-export.json
*-export.json
exports/

# ── Browser / IndexedDB / local databases ──
*.sqlite
*.sqlite3
*.db
*.indexeddb
*.leveldb
IndexedDB/
LocalStorage/

# ── Editor / IDE ──
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ── OS cruft ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Logs ──
logs/
*.log

# Research inputs — third-party transcripts, kept local only
youtube transcripts for context and learning and applying/

# Personal AI boot config — machine-local, not project code (public repo)
CLAUDE.md
